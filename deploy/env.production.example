# Copy thanh /opt/fc-overlay/.env tren VPS (KHONG gui file nay cho ai).
HOST=127.0.0.1
PORT=4173
FC_PUBLIC_ORIGIN=https://overlay.example.com
# Caddy chay cung may: rate limit theo IP that cua client.
FC_TRUST_PROXY=1
# An token OBS khoi log (tu bat khi co FC_PUBLIC_ORIGIN).
FC_HIDE_SECRETS=1
FC_ADMIN_PASSWORD=admin123
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET
