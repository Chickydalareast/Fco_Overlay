# Copy to .env and replace values from LiveKit Cloud dashboard.
# Keep .env PRIVATE; do not upload to GitHub or share with players.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET
# Optional: change these if deploying the server.
HOST=127.0.0.1
PORT=4173
# Studio password defaults to admin123 (v0.3F). Uncomment to change it:
# FC_ADMIN_PASSWORD=admin123

# When deploying behind HTTPS/Caddy, set this to your domain origin.
# Prevents forged Host / X-Forwarded-Proto from affecting Player/OBS links.
# FC_PUBLIC_ORIGIN=https://overlay.example.com

# v0.3G (VPS only): Caddy/Nginx on the same machine -> real client IP for rate limits.
# FC_TRUST_PROXY=1
# Hide OBS token from logs (automatic when FC_PUBLIC_ORIGIN is set).
# FC_HIDE_SECRETS=1
